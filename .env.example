# Optional: chain to a different env file (ignored if --env-file is passed)
RUN_VLC_SHOW_ENV_FILE=

# Required if you don't pass positional `shows_dir`
RUN_VLC_SHOW_SHOWS_DIR=venue/home-studio/shows

# ArtNet output options
RUN_VLC_SHOW_IP=
RUN_VLC_SHOW_BIND_IP=
RUN_VLC_SHOW_UNIVERSE=
RUN_VLC_SHOW_PORT=6454

# VC/function selection options
RUN_VLC_SHOW_BUTTON_ID=
RUN_VLC_SHOW_BUTTON_CAPTION=
RUN_VLC_SHOW_FUNCTION_ID=

# Runtime options
RUN_VLC_SHOW_FPS=40
RUN_VLC_SHOW_MAX_SECONDS=
RUN_VLC_SHOW_DRY_RUN=false
RUN_VLC_SHOW_VERBOSE=false

# VLC HTTP options
RUN_VLC_SHOW_VLC_URL=http://127.0.0.1:8080
RUN_VLC_SHOW_VLC_PASSWORD=replace-me
RUN_VLC_SHOW_VLC_TIMEOUT=1.0

# Follow mode options
RUN_VLC_SHOW_FOLLOW=false
RUN_VLC_SHOW_POLL_INTERVAL=0.5
RUN_VLC_SHOW_RESYNC_THRESHOLD=1.0
