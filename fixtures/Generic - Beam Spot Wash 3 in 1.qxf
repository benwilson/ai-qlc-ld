  <Capability Min="194" Max="255" Preset="RotationClockwiseSlowToFast">Clockwise rotation (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Focus" Preset="BeamFocusNearFar"/>
 <Channel Name="Shutter">
