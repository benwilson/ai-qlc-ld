  <Capability Min="0" Max="7" Preset="PrismEffectOff">No effect</Capability>
  <Capability Min="8" Max="255" Preset="PrismEffectOn" Res1="3">3-facet prism</Capability>
 </Channel>
 <Channel Name="Prism rotation">
  <Group Byte="0">Prism</Group>
  <Capability Min="0" Max="127">Index</Capability>
  <Capability Min="128" Max="189" Preset="RotationCounterClockwiseFastToSlow">Counter-clockwise rotation (Fast to slow)</Capability>
