<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.0.1</Version>
  <Author>Ben Wilson</Author>
 </Creator>
 <Manufacturer>Generic</Manufacturer>
 <Model>Nausea Inducer 3000</Model>
 <Type>Flower</Type>
 <Channel Name="Pan">
  <Group Byte="0">Pan</Group>
  <Capability Min="0" Max="255">0-540 degree rotation</Capability>
 </Channel>
 <Channel Name="Tilt 1">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="127">0-360 degree rotation</Capability>
  <Capability Min="128" Max="191">Tilt forward rotation (slow to fast)</Capability>
  <Capability Min="192" Max="255">Tilt reverse rotation (fast to slow)</Capability>
 </Channel>
 <Channel Name="Tilt 2">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="127">0-360 degree rotation</Capability>
  <Capability Min="128" Max="191">Tilt forward rotation (slow to fast)</Capability>
  <Capability Min="192" Max="255">Tilt reverse rotation (fast to slow)</Capability>
 </Channel>
 <Channel Name="Tilt 3">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="127">0-360 degree rotation</Capability>
  <Capability Min="128" Max="191">Tilt forward rotation (slow to fast)</Capability>
  <Capability Min="192" Max="255">Tilt reverse rotation (fast to slow)</Capability>
 </Channel>
 <Channel Name="P/T Speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Dimmer" Preset="IntensityDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="9" Preset="ShutterOpen">On</Capability>
  <Capability Min="10" Max="249" Preset="StrobeSlowToFast">Strobe (slow to fast)</Capability>
  <Capability Min="250" Max="255" Preset="ShutterOpen">On</Capability>
 </Channel>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="LED effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="255">LED Effects</Capability>
 </Channel>
 <Channel Name="Motor effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="255">Motor Effects</Capability>
 </Channel>
 <Channel Name="Effect speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Effect speed (slow to fast)</Capability>
 </Channel>
 <Channel Name="Red laser">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="15">Off</Capability>
  <Capability Min="16" Max="249" Preset="StrobeSlowToFast">Strobe (slow to fast)</Capability>
  <Capability Min="250" Max="255">On</Capability>
 </Channel>
 <Channel Name="Green laser">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="15">Off</Capability>
  <Capability Min="16" Max="249" Preset="StrobeSlowToFast">Strobe (slow to fast)</Capability>
  <Capability Min="250" Max="255">On</Capability>
 </Channel>
 <Channel Name="Blue laser">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="15">Off</Capability>
  <Capability Min="16" Max="249" Preset="StrobeSlowToFast">Strobe (slow to fast)</Capability>
  <Capability Min="250" Max="255">On</Capability>
 </Channel>
 <Channel Name="Halo LED effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="31">Red</Capability>
  <Capability Min="32" Max="47">Green</Capability>
  <Capability Min="48" Max="63">Blue</Capability>
  <Capability Min="64" Max="79">Yellow</Capability>
  <Capability Min="80" Max="95">Pink</Capability>
  <Capability Min="96" Max="111">Cyan</Capability>
  <Capability Min="112" Max="127">RGB</Capability>
  <Capability Min="128" Max="255">Color jump (fast to slow)</Capability>
 </Channel>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="250">No function</Capability>
 </Channel>
 <Mode Name="19 channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt 1</Channel>
  <Channel Number="2">Tilt 2</Channel>
  <Channel Number="3">Tilt 3</Channel>
  <Channel Number="4">P/T Speed</Channel>
  <Channel Number="5">Dimmer</Channel>
  <Channel Number="6">Strobe</Channel>
  <Channel Number="7">Red</Channel>
  <Channel Number="8">Green</Channel>
  <Channel Number="9">Blue</Channel>
  <Channel Number="10">White</Channel>
  <Channel Number="11">LED effect</Channel>
  <Channel Number="12">Motor effect</Channel>
  <Channel Number="13">Effect speed</Channel>
  <Channel Number="14">Red laser</Channel>
  <Channel Number="15">Green laser</Channel>
  <Channel Number="16">Blue laser</Channel>
  <Channel Number="17">Halo LED effect</Channel>
  <Channel Number="18">Reset</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
   <Channel>7</Channel>
   <Channel>8</Channel>
   <Channel>9</Channel>
   <Channel>10</Channel>
   <Channel>14</Channel>
   <Channel>15</Channel>
   <Channel>16</Channel>
   <Channel>17</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="2500" ColourTemperature="6500"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="3" DegreesMax="25"/>
  <Focus Type="Barrel" PanMax="540" TiltMax="0"/>
  <Technical PowerConsumption="0" DmxConnector="3-pin and 5-pin"/>
 </Physical>
</FixtureDefinition>
