  <!-- ==================== HIGH ENERGY (4) ======================== -->

  <!-- 1/16th note white strobe - pure aggression -->
  <Function ID="100" Type="Chaser" Name="HE: Strobe Snap" Path="High Energy">
   <Speed FadeIn="0" FadeOut="0" Duration="86"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <SpeedModes FadeIn="Common" FadeOut="Common" Duration="Common"/>
   <Step Number="0" FadeIn="0" Hold="0" FadeOut="0">8</Step>
   <Step Number="1" FadeIn="0" Hold="0" FadeOut="0">9</Step>
  </Function>

  <!-- 1/8th note white sweep across pars - Amen break energy -->
  <Function ID="101" Type="Chaser" Name="HE: Rapid Fire" Path="High Energy">
   <Speed FadeIn="0" FadeOut="0" Duration="172"/>
   <Direction>Forward</Direction>
   <RunOrder>PingPong</RunOrder>
